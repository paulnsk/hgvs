<UserControl x:Class="FileCopyExtension.HgToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:FileCopyExtension"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600"
             Name="MyToolWindow">

    <UserControl.Resources>
        <local:StatusToColorConverter x:Key="StatusColorConverter"/>

        <!-- Стиль для ListViewItem -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для RadioButton/CheckBox -->
        <Style TargetType="Control" x:Key="OptionStyle">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0 Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- 1 Options -->
            <RowDefinition Height="Auto"/>
            <!-- 2 Filter -->
            <RowDefinition Height="Auto"/>
            <!-- 3 Exclude (NEW) -->
            <RowDefinition Height="Auto"/>
            <!-- 4 Status -->
            <RowDefinition Height="*"/>
            <!-- 5 List -->
        </Grid.RowDefinitions>

        <!-- 1. Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Name="btnRefresh" Content="Refresh" Width="80" Height="25" Margin="0,0,5,0" Click="BtnRefresh_Click"/>
            <Button Name="btnOpenAll" Content="Open All" Width="80" Height="25" Click="BtnOpenAll_Click"/>
            <Button Name="btnUndo" Content="Undo Changes" Width="90" Height="25" Click="BtnUndo_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- 2. Options -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,5">
            <RadioButton Name="rbUncommitted" Content="Uncommitted Only" GroupName="Mode" IsChecked="True" 
                         Checked="Mode_Checked" Style="{StaticResource OptionStyle}"/>
            <RadioButton Name="rbBranch" Content="Entire Branch (vs Parent)" GroupName="Mode" 
                         Checked="Mode_Checked" Style="{StaticResource OptionStyle}"/>
            <RadioButton Name="rbBaseBranchHead" Content="Vs Parent Branch HEAD" GroupName="Mode" 
                         Checked="Mode_Checked" Style="{StaticResource OptionStyle}"/>

            <!-- Новый чекбокс -->
            <CheckBox Name="chkShowUntracked" Content="Show Untracked (?)" 
                      Checked="CheckBox_Checked" Unchecked="CheckBox_Checked"
                      Style="{StaticResource OptionStyle}" Margin="10,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="5,0,5,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0" 
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <TextBox Name="txtFilter" Grid.Column="1" TextChanged="TxtFilter_TextChanged"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                     Foreground="#FF90EE90" 
                     FontWeight="Bold"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
            <!-- LightGreen, adjusted for readability logic in code if needed, but #FF90EE90 works on dark -->
        </Grid>

        <!-- 3. Exclude (Red) (NEW) -->
        <Grid Grid.Row="3" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Exclude:" VerticalAlignment="Center" Margin="0,0,5,0" 
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <TextBox Name="txtExclude" Grid.Column="1" TextChanged="TxtFilter_TextChanged"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                     Foreground="#FFFF7F7F"
                     FontWeight="Bold"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
            <!-- LightRed/Salmon -->
        </Grid>

        <!-- 4. Status Info -->
        <TextBlock Grid.Row="4" Name="txtStatusInfo" 
                   Text="Ready" 
                   Margin="5,0,5,5" 
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis">
            <TextBlock.ToolTip>
                <ToolTip Content="{Binding Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=TextBlock}}"/>
            </TextBlock.ToolTip>
        </TextBlock>

        <!-- 5. File List -->
        <ListView Name="lvFiles" Grid.Row="5" Margin="5" MouseDoubleClick="LvFiles_MouseDoubleClick" 
                  Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                  BorderThickness="0"
                  GridViewColumnHeader.Click="GridViewColumnHeader_Click"
                  SelectionChanged="LvFiles_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="40">
                        <GridViewColumnHeader Content="St" Tag="Status"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" 
                                           Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                           FontWeight="Bold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="800">
                        <GridViewColumnHeader Content="File Path" Tag="Path"/>
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="Path"/>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>