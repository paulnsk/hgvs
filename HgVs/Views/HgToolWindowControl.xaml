<UserControl x:Class="HgVs.Views.HgToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:HgVs"
             xmlns:viewmodels="clr-namespace:HgVs.ViewModels"
             xmlns:views="clr-namespace:HgVs.Views"
             xmlns:models="clr-namespace:HgVs.Models"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <views:StatusToColorConverter x:Key="StatusColorConverter"/>
        <views:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <viewmodels:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="False"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="False" SnapsToDevicePixels="True">
                                <GridViewRowPresenter
                                    Content="{TemplateBinding Content}"
                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <Border Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Margin="2,-2,0,-2" Panel.ZIndex="1"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFC06B28"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlternateGroup}" Value="True">
                                                    <Setter Property="Background" Value="#FF945DB7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTodoItem}" Value="False">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <EventSetter Event="MouseDoubleClick" Handler="LvFiles_MouseDoubleClick"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="LvFiles_PreviewMouseRightButtonDown"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="InlineIconButtonStyle">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="CornflowerBlue"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem" x:Key="FileContextMenuItemStyle">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator" x:Key="FileContextMenuSeparatorStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}">
                            <Border Height="1" Margin="28,3,5,3"
                                    Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Control" x:Key="OptionStyle">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton" x:Key="RadioOptionStyle" BasedOn="{StaticResource OptionStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="RadioBorder" Width="13" Height="13"
                                     Fill="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                                     Stroke="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                                     StrokeThickness="1"/>
                            <Ellipse x:Name="RadioDot" Width="6" Height="6" Fill="CornflowerBlue"
                                     Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioBorder" Property="Stroke" Value="CornflowerBlue"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RadioBorder" Property="Stroke" Value="CornflowerBlue"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioBorder" Property="Stroke" Value="CornflowerBlue"/>
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="CheckOptionStyle" BasedOn="{StaticResource OptionStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="13" Height="13"
                                    Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                                    BorderThickness="1">
                                <Path x:Name="CheckGlyph" Data="M 2,6 L 5,9 L 11,2" Stroke="CornflowerBlue"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="CornflowerBlue"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="CornflowerBlue"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="CornflowerBlue"/>
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="ThemedRevisionComboBoxStyle">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="21"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox" Margin="2,0,0,0" Padding="2,0"
                                             VerticalContentAlignment="Center" Background="Transparent"
                                             BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                             FontWeight="{TemplateBinding FontWeight}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                    <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="ArrowBackground" Background="Transparent">
                                                    <Path Width="8" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0,0 L 4,4 L 8,0 Z"
                                                          Fill="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ArrowBackground" Property="Background"
                                                                Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                                        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                                        BorderThickness="1">
                                    <ScrollViewer MaxHeight="330" CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="CornflowerBlue"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedMode}" Value="{x:Static models:HgDisplayMode.CustomBranch}">
                    <Setter Property="Foreground" Value="#FF87CEFA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Buttons -->
        <DockPanel Grid.Row="0" Margin="5" LastChildFill="False">
            <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                    BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Files" GroupName="ListMode" Style="{StaticResource RadioOptionStyle}" Margin="0,0,9,0"
                         IsChecked="{Binding SelectedListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgListMode.Files}}"/>
                    <RadioButton Content="TODO" GroupName="ListMode" Style="{StaticResource RadioOptionStyle}" Margin="0"
                         IsChecked="{Binding SelectedListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgListMode.Todo}}"/>
                    <Border Width="1" Margin="9,0" Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsTodoMode, Converter={StaticResource InverseBoolConverter}}">
                        <RadioButton Content="List" GroupName="FileLayout" Style="{StaticResource RadioOptionStyle}" Margin="0,0,9,0"
                                     IsChecked="{Binding UseTreeView, Converter={StaticResource InverseBoolConverter}}"/>
                        <RadioButton Content="Tree" GroupName="FileLayout" Style="{StaticResource RadioOptionStyle}" Margin="0"
                                     IsChecked="{Binding UseTreeView}"/>
                        <!-- Collapse by rule: the icon applies the last rule, the arrow opens the rule menu -->
                        <StackPanel x:Name="CollapseRulePanel" Orientation="Horizontal" Margin="5,0,0,0"
                                    IsEnabled="{Binding IsTreeMode}" ToolTip="{Binding CollapseButtonToolTip}"
                                    ToolTipService.ShowOnDisabled="True">
                            <Button Style="{StaticResource InlineIconButtonStyle}" Width="18" Height="17" Click="CollapseRuleApply_Click">
                                <Path Width="13" Height="13" SnapsToDevicePixels="True" StrokeThickness="1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M0.5,0.5 H6.5 V6.5 H0.5 Z M2,3.5 H5 M3.5,6.5 V12.5 M3.5,9.5 H7 M3.5,12.5 H7 M8.5,9.5 H13 M8.5,12.5 H13"/>
                            </Button>
                            <Button Style="{StaticResource InlineIconButtonStyle}" Width="11" Height="17" Click="CollapseRuleMenu_Click">
                                <Path Width="7" Height="4" Data="M 0,0 L 3.5,4 L 7,0 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Refresh" Width="80" Height="25" Margin="0,0,5,0" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Open All" Width="80" Height="25" Margin="0,0,5,0" Command="{Binding OpenAllCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Undo Changes" Width="90" Height="25"
                        Command="{Binding UndoCommand}" CommandParameter="{Binding SelectedUndoItems}"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Options -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,5" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <RadioButton Content="Uncommitted Only" GroupName="Mode" Style="{StaticResource RadioOptionStyle}"
                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.Uncommitted}}"/>
            <RadioButton Content="Entire Branch (vs Parent)" GroupName="Mode" Style="{StaticResource RadioOptionStyle}"
                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.Branch}}"/>
            <RadioButton Content="Vs Parent Branch HEAD" GroupName="Mode" Style="{StaticResource RadioOptionStyle}"
                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.BaseBranchHead}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <RadioButton Content="vs " GroupName="Mode" Style="{StaticResource RadioOptionStyle}" Margin="0"
                     IsEnabled="{Binding HasCompareBranchName}"
                     IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.CustomBranch}}"/>
                <ComboBox Width="135" IsEditable="True" IsTextSearchEnabled="True"
                           Style="{StaticResource ThemedRevisionComboBoxStyle}"
                           TextSearch.TextPath="Revision"
                           Text="{Binding CompareBranchName, UpdateSourceTrigger=PropertyChanged}"
                           SelectedItem="{Binding SelectedMergeBaseCandidate, Mode=TwoWay}"
                           ItemsSource="{Binding MergeBaseCandidates}"
                          Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                          BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                          FontWeight="Bold" VerticalAlignment="Center" Padding="2,0"
                          ToolTip="Base revision for comparison. Choose a merged parent below, or type a branch, revision number, or hash. The latest merged default usually isolates this branch's own changes.">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="760" MaxWidth="1000" Padding="8,5" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"
                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="138"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Branch}" FontWeight="Bold" Foreground="CornflowerBlue"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Branch}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="8,0"
                                               TextTrimming="WordEllipsis" ToolTip="{Binding Description}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RevisionLabel}" HorizontalAlignment="Right"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Revision}" Margin="8,0,0,0"
                                               FontFamily="Consolas" Foreground="CornflowerBlue"/>

                                    <TextBlock Grid.Row="1" Text="{Binding MergeLabel}" FontSize="10" Foreground="Gray"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Date}" HorizontalAlignment="Right"
                                               FontSize="10" Foreground="Gray"/>
                                    <Border Grid.Row="1" Grid.Column="1" Margin="8,2,0,0" Padding="4,0"
                                            HorizontalAlignment="Left" CornerRadius="2" Background="#406E5A20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLatestDefault}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="LATEST MERGED DEFAULT" FontSize="9" FontWeight="Bold" Foreground="Goldenrod"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <CheckBox Content="Show Untracked (?)" IsChecked="{Binding ShowUntracked}" Style="{StaticResource CheckOptionStyle}" Margin="10,0,0,0"/>
            <CheckBox Content="Hide Unchanged" IsChecked="{Binding HideUnchanged}" Style="{StaticResource CheckOptionStyle}"
                      Margin="10,0,0,0" Visibility="{Binding HasUnchangedFiles, Converter={StaticResource BoolToVis}}"/>
        </WrapPanel>

        <!-- 3. Filter -->
        <Grid Grid.Row="2" Margin="5,0,5,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" Foreground="#FF90EE90" FontWeight="Bold"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
        </Grid>

        <!-- 4. Exclude -->
        <Grid Grid.Row="3" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Exclude:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <TextBox Grid.Column="1" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" Foreground="#FFFF7F7F" FontWeight="Bold"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
        </Grid>

        <!-- 5. Status Info (MVVM Styled Text) -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding StatusRuns}" Margin="5,0,5,5">
            <ItemsControl.ToolTip>
                <ToolTip Content="{Binding StatusTooltip}"/>
            </ItemsControl.ToolTip>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Fallback color to VS text key if no foreground provided -->
                    <TextBlock Text="{Binding Text}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Foreground}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 6. File List -->
        <ListView Name="lvFiles" Grid.Row="5" Margin="5" ItemsSource="{Binding FilesView}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SnapsToDevicePixels="True" UseLayoutRounding="True"
                  Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                  BorderThickness="0" GridViewColumnHeader.Click="GridViewColumnHeader_Click"
                  SelectionChanged="LvFiles_SelectionChanged"
                  PreviewKeyDown="LvFiles_PreviewKeyDown">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTreeMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.ContextMenu>
                <ContextMenu Opened="FileContextMenu_Opened"
                             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
                    <MenuItem Header="Open" Tag="Open" Style="{StaticResource FileContextMenuItemStyle}" Click="ContextOpen_Click"/>
                    <MenuItem Header="Open Diff" Tag="OpenDiff" Style="{StaticResource FileContextMenuItemStyle}" Click="ContextOpenDiff_Click"/>
                    <Separator Style="{StaticResource FileContextMenuSeparatorStyle}"/>
                    <MenuItem Header="Mark as Viewed" Tag="ToggleViewed" Style="{StaticResource FileContextMenuItemStyle}" Click="ContextToggleViewed_Click"/>
                    <Separator Style="{StaticResource FileContextMenuSeparatorStyle}"/>
                    <MenuItem Header="Mark ALL as viewed" Tag="MarkAllViewed" Style="{StaticResource FileContextMenuItemStyle}" Click="ContextMarkAllViewed_Click">
                        <MenuItem.Icon>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,1,0" Fill="Transparent" Stroke="#FFB9A66A" StrokeThickness="1.2"/>
                                <Ellipse Width="7" Height="7" Fill="Transparent" Stroke="#FFB9A66A" StrokeThickness="1.2"/>
                            </StackPanel>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mark ALL as not viewed" Tag="MarkAllNotViewed" Style="{StaticResource FileContextMenuItemStyle}" Click="ContextMarkAllNotViewed_Click">
                        <MenuItem.Icon>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,1,0" Fill="#FFB9A66A" Stroke="#FFB9A66A" StrokeThickness="1.2"/>
                                <Ellipse Width="7" Height="7" Fill="#FFB9A66A" Stroke="#FFB9A66A" StrokeThickness="1.2"/>
                            </StackPanel>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Style="{StaticResource FileContextMenuSeparatorStyle}"/>
                    <MenuItem Header="Un-view multiple files..." Tag="MarkFromListNotViewed"
                              Style="{StaticResource FileContextMenuItemStyle}"
                              Click="ContextMarkFilesFromListNotViewed_Click">
                        <MenuItem.Icon>
                            <Ellipse Width="8" Height="8" Fill="#FFB9A66A" Stroke="#FFB9A66A" StrokeThickness="1.2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="GroupColumn" Width="0">
                        <GridViewColumnHeader/>
                    </GridViewColumn>
                    <GridViewColumn Width="40">
                        <GridViewColumnHeader Content="St" Tag="Status"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" FontWeight="Bold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="24">
                        <GridViewColumnHeader Content="Rv" Padding="0" ToolTip="Review"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" HorizontalAlignment="Stretch" Height="18" Cursor="Hand"
                                        MouseLeftButtonDown="ReviewCell_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="ToolTip" Value="not viewed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReviewed}" Value="True">
                                                    <Setter Property="ToolTip" Value="viewed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Ellipse Width="8" Height="8" Fill="#FFB9A66A" Stroke="#FFB9A66A"
                                             StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReviewed}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TodoColumn" Width="0">
                        <GridViewColumnHeader Content="TODO"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TodoText}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TodoText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="FileColumn" Width="800">
                        <GridViewColumnHeader Content="File Path" Tag="Path"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnchanged}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.DropDownDisabledGlyphKey}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <ListBox x:Name="lvTree" Grid.Row="5" Margin="5" BorderThickness="0"
                 ItemsSource="{Binding FileTree.Rows}" SelectedItem="{Binding FileTree.SelectedRow, Mode=TwoWay}"
                 Visibility="{Binding IsTreeMode, Converter={StaticResource BoolToVis}}"
                 Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                 Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                 ContextMenu="{Binding ContextMenu, ElementName=lvFiles}"
                 SelectionChanged="Tree_SelectionChanged" PreviewKeyDown="Tree_PreviewKeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <EventSetter Event="MouseDoubleClick" Handler="Tree_MouseDoubleClick"/>
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Tree_PreviewMouseRightButtonDown"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="{Binding Indent}" MinHeight="20">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="16"/>
                            <TextBlock Width="18" Text="{Binding File.Status}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding File.Status, Converter={StaticResource StatusColorConverter}}"/>
                            <Border Width="18" Height="20" Background="Transparent" Cursor="Hand"
                                    DataContext="{Binding File}" MouseLeftButtonDown="ReviewCell_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="ToolTip" Value="not viewed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReviewed}" Value="True">
                                                <Setter Property="ToolTip" Value="viewed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Ellipse Width="8" Height="8" Fill="#FFB9A66A" Stroke="#FFB9A66A" StrokeThickness="1.2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReviewed}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding File.Path}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding File.IsUnchanged}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.DropDownDisabledGlyphKey}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                            <Border Width="16" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="TreeArrow_MouseLeftButtonDown">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▸"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▾"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Path Width="14" Height="12" Margin="2,0,6,0" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M 1,3 L 1,11 L 13,11 L 13,3 L 7,3 L 5,1 L 1,1 Z"
                                  Stroke="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" StrokeThickness="1"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Key}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
