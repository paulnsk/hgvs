<UserControl x:Class="HgVs.Views.HgToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:HgVs"
             xmlns:viewmodels="clr-namespace:HgVs.ViewModels"
             xmlns:views="clr-namespace:HgVs.Views"
             xmlns:models="clr-namespace:HgVs.Models"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <views:StatusToColorConverter x:Key="StatusColorConverter"/>
        <views:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <viewmodels:EnumToBooleanConverter x:Key="EnumToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="False"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="False" SnapsToDevicePixels="True">
                                <GridViewRowPresenter
                                    Content="{TemplateBinding Content}"
                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <Border Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Margin="2,-2,0,-2" Panel.ZIndex="1"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFC06B28"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlternateGroup}" Value="True">
                                                    <Setter Property="Background" Value="#FF945DB7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsTodoItem}" Value="False">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="LvFiles_MouseDoubleClick"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.CommandBarHoverKey}}"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Control" x:Key="OptionStyle">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Buttons -->
        <DockPanel Grid.Row="0" Margin="5" LastChildFill="False">
            <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                    BorderThickness="1" CornerRadius="3" Padding="7,3" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Files" GroupName="ListMode" Style="{StaticResource OptionStyle}" Margin="0,0,9,0"
                         IsChecked="{Binding SelectedListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgListMode.Files}}"/>
                    <RadioButton Content="TODO" GroupName="ListMode" Style="{StaticResource OptionStyle}" Margin="0"
                         IsChecked="{Binding SelectedListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgListMode.Todo}}"/>
                </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Refresh" Width="80" Height="25" Margin="0,0,5,0" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Open All" Width="80" Height="25" Margin="0,0,5,0" Command="{Binding OpenAllCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Undo Changes" Width="90" Height="25"
                        Command="{Binding UndoCommand}" CommandParameter="{Binding SelectedItems, ElementName=lvFiles}"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. Options -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,5" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <RadioButton Content="Uncommitted Only" GroupName="Mode" Style="{StaticResource OptionStyle}"
                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.Uncommitted}}"/>
            <RadioButton Content="Entire Branch (vs Parent)" GroupName="Mode" Style="{StaticResource OptionStyle}"
                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.Branch}}"/>
            <RadioButton Content="Vs Parent Branch HEAD" GroupName="Mode" Style="{StaticResource OptionStyle}"
                 IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.BaseBranchHead}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <RadioButton Content="vs " GroupName="Mode" Style="{StaticResource OptionStyle}" Margin="0"
                     IsChecked="{Binding SelectedMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static models:HgDisplayMode.CustomBranch}}"/>
                <TextBox Width="100" Text="{Binding CompareBranchName, UpdateSourceTrigger=PropertyChanged}" 
                 Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                 BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"
                 FontWeight="Bold" VerticalAlignment="Center" Padding="2,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMode}" Value="{x:Static models:HgDisplayMode.CustomBranch}">
                                    <Setter Property="Foreground" Value="#FF87CEFA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <CheckBox Content="Show Untracked (?)" IsChecked="{Binding ShowUntracked}" Style="{StaticResource OptionStyle}" Margin="10,0,0,0"/>
            <CheckBox Content="Hide Unchanged" IsChecked="{Binding HideUnchanged}" Style="{StaticResource OptionStyle}"
                      Margin="10,0,0,0" Visibility="{Binding HasUnchangedFiles, Converter={StaticResource BoolToVis}}"/>
        </WrapPanel>

        <!-- 3. Filter -->
        <Grid Grid.Row="2" Margin="5,0,5,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" Foreground="#FF90EE90" FontWeight="Bold"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
        </Grid>

        <!-- 4. Exclude -->
        <Grid Grid.Row="3" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Exclude:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
            <TextBox Grid.Column="1" Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}" Foreground="#FFFF7F7F" FontWeight="Bold"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowFrameKey}}"/>
        </Grid>

        <!-- 5. Status Info (MVVM Styled Text) -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding StatusRuns}" Margin="5,0,5,5">
            <ItemsControl.ToolTip>
                <ToolTip Content="{Binding StatusTooltip}"/>
            </ItemsControl.ToolTip>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Fallback color to VS text key if no foreground provided -->
                    <TextBlock Text="{Binding Text}" FontWeight="{Binding FontWeight}" FontStyle="{Binding FontStyle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Foreground}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 6. File List -->
        <ListView Name="lvFiles" Grid.Row="5" Margin="5" ItemsSource="{Binding FilesView}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SnapsToDevicePixels="True" UseLayoutRounding="True"
                  Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                  BorderThickness="0" GridViewColumnHeader.Click="GridViewColumnHeader_Click"
                  SelectionChanged="LvFiles_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="GroupColumn" Width="0">
                        <GridViewColumnHeader/>
                    </GridViewColumn>
                    <GridViewColumn Width="40">
                        <GridViewColumnHeader Content="St" Tag="Status"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" FontWeight="Bold"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="TodoColumn" Width="0">
                        <GridViewColumnHeader Content="TODO"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TodoText}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TodoText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="FileColumn" Width="800">
                        <GridViewColumnHeader Content="File Path" Tag="Path"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnchanged}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.DropDownDisabledGlyphKey}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
